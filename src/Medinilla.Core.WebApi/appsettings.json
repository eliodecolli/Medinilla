{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3101",
          "tenant": "fake",
          "labels": [
            { "Key": "app", "Value": "Medinilla.WebApi" },
            { "Key": "env", "Value": "dev" }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Comms": {
    "RequestQueue": "medinilla.core.request"
  },
  "General": {
    "MessageQueueTTL": 5
  }
}
