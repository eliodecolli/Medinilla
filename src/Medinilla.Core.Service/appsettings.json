{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3101",
          "tenant": "fake",
          "labels": [
            { "Key": "app", "Value": "Medinilla.Core.Service" },
            { "Key": "env", "Value": "dev" }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://127.0.0.1:5005",
        "Protocols": "Http2"
      }
    }
  }
}